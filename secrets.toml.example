# Copy values into Streamlit Community Cloud > App settings > Secrets.
# Locally, copy this file to .streamlit/secrets.toml and fill in real values.
DASHBOARD_PASSWORD = "replace-with-a-long-random-password"

GROQ_API_KEY = ""
GROQ_MODEL = "openai/gpt-oss-20b"

# Supabase Project Settings > Database > connection string (URI).
# Prefer the pooler connection string if using hosted deployment.
DATABASE_URL = ""

# Create a PUBLIC bucket named influencer-media for Instagram image fetches.
SUPABASE_URL = ""
SUPABASE_SERVICE_ROLE_KEY = ""
SUPABASE_BUCKET = "influencer-media"

# Instagram Login credentials for your own professional Creator account.
INSTAGRAM_ACCESS_TOKEN = ""
INSTAGRAM_USER_ID = ""
INSTAGRAM_API_BASE_URL = "https://graph.instagram.com"
META_GRAPH_VERSION = "v27.0"

TIMEZONE = "Asia/Kolkata"
